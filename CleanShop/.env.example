# Copie este arquivo para .env e preencha com os valores reais.
# O .env fica só na sua máquina e NUNCA vai para o Git.
# "__" (dois underlines) equivale ao ":" do appsettings.json (ex.: Jwt__Key = Jwt:Key).
# Use aspas simples para que caracteres especiais sejam lidos literalmente.

# Senha do usuário "sa" do SQL Server no Docker.
# Mínimo 8 caracteres com maiúsculas, minúsculas, números e símbolos (evite $ ; ' ").
MSSQL_SA_PASSWORD='TroqueEstaSenha#2026'

# Connection string usada ao rodar localmente (dotnet run / Visual Studio), apontando para o container.
# Use a mesma senha de MSSQL_SA_PASSWORD. No Docker, a API usa Server=sqlserver (definido no docker-compose.yml).
ConnectionStrings__NorthwindConnection='Server=localhost,1433;Database=Northwind;User Id=sa;Password=TroqueEstaSenha#2026;TrustServerCertificate=True;'

# Chave de assinatura dos tokens JWT (mínimo 32 caracteres; gere com: openssl rand -base64 64)
Jwt__Key='TROQUE_POR_UMA_CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES'
